{
  "name": "danmu-classroom-screen",
  "description": "danmu-classroom-screen",
  "author": "楊竑昕 <jk195417@gmail.com>",
  "repository": "https://github.com/danmu-classroom/danmu-classroom-screen",
  "homepage": "https://github.com/danmu-classroom/danmu-classroom-screen",
  "license": "MIT",
  "version": "0.4.1",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development electron-vite dev",
    "start": "electron-vite build && cross-env NODE_ENV=development electron .",
    "build": "electron-vite build && electron-builder -wml",
    "clean": "rimraf ./dist ./out",
    "clean:super": "rimraf ./dist ./out ./node_modules",
    "format": "yarn format:eslint && yarn format:prettier",
    "format:eslint": "eslint --fix .",
    "format:prettier": "prettier --write .",
    "lint": "eslint . && prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "electron:pack": "electron-vite build && electron-builder --dir",
    "electron:dist": "electron-vite build && electron-builder",
    "electron:dist:all": "electron-vite build && electron-builder -wml"
  },
  "dependencies": {
    "@hotwired/stimulus": "^3.2.2",
    "bootstrap": "^5.3.8",
    "electron-log": "^5.4.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^24.0.0",
    "cross-env": "^10.0.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.0.0",
    "prettier": "^3.9.10",
    "rimraf": "^6.0.0",
    "sass": "^1.106.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "build": {
    "appId": "com.electron.danmu-classroom-screen",
    "productName": "danmu-classroom-screen",
    "copyright": "Copyright © 2020 楊竑昕",
    "directories": {
      "buildResources": "build-resources"
    },
    "mac": {
      "category": "public.app-category.utilities"
    },
    "win": {
      "target": "portable"
    },
    "files": [
      "out/**/*",
      "package.json"
    ]
  },
  "engines": {
    "node": ">=24"
  }
}
